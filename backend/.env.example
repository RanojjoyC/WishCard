PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas SRV or local mongodb://localhost:27017/wishcard)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/wishcard?retryWrites=true&w=majority

# JWT Secret Key (Required for server startup)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_32_characters

# Client Origin (CORS and Socket.io)
CLIENT_URL=http://localhost:5173

# Razorpay Test / Production Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudinary Storage for purchase proofs & receipts
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial Seeded Admin Credentials (seeded once on first start)
ADMIN_NAME="Platform Administrator"
ADMIN_EMAIL=admin@wishcard.com
ADMIN_PASSWORD=change_this_admin_password_in_production
ADMIN_UPI_ID=escrow@wishcard
